{
  "name": "pi-claude-native",
  "version": "0.9.0",
  "type": "module",
  "description": "Claude as a Pi model provider through the unmodified Claude Code executable. Pi owns the transcript and tools; the CLI supplies subscription authentication as a model transport.",
  "license": "MIT",
  "author": "yamatakeru",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yamatakeru/pi-claude-native.git"
  },
  "homepage": "https://github.com/yamatakeru/pi-claude-native#readme",
  "bugs": {
    "url": "https://github.com/yamatakeru/pi-claude-native/issues"
  },
  "keywords": ["pi-package", "pi", "extension", "claude", "claude-code", "model-provider"],
  "files": [
    "extensions/**/*",
    "src/**/*",
    "scripts/verify.py",
    "scripts/verify_warm.py",
    "scripts/trace-native.mjs",
    "docs/**/*",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "pi": {
    "extensions": [
      "./extensions/claude-native/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "allowScripts": {
    "@google/genai@2.21.0": true,
    "protobufjs@7.6.6": true
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --experimental-strip-types --disable-warning=DEP0205 --import ./tests/register.mjs --test \"tests/*.test.ts\"",
    "verify": "python3 scripts/verify.py startup"
  }
}
